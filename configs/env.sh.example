# Private settings. Nonempty values override inherited environment variables.
# Leave blank to inherit the terminal value or the project default.
EVIWEAVE_API_KEY=""
EVIWEAVE_PYTHON=""
EVIWEAVE_CONFIG=""
EVIWEAVE_DATASET=""
EVIWEAVE_EVALUATION_ROOT=""
# Optional existing Docker connection; installation never starts Docker.
# DOCKER_HOST="unix:///path/to/project-local/docker.sock"
# Explicit independent profile, after collect/check; blank keeps the exact original default.
EVIWEAVE_ENVIRONMENT_PROFILE=""
