include LICENSE README.md README.zh-CN.md DATA_FORMAT.md AGENTS.md pyproject.toml MANIFEST.in .gitignore
include EXPERIMENTS.md EXPERIMENTS.zh-CN.md CITATION.cff CHANGELOG.md RELEASE_NOTES.md ROADMAP.md
recursive-include src *.py
recursive-include configs *.yaml
include configs/observability.example.json configs/pricing.example.json
exclude configs/local* configs/*.local.*
recursive-include provenance *.json *.md
recursive-include tests *.py
recursive-include tools *.py
recursive-include scripts *.py *.sh
include .github/workflows/offline.yml
include docker/Dockerfile.workbench docker/.dockerignore
include docker/Dockerfile.public-workbench
recursive-include docker/workbench *.md *.json *.txt
recursive-include examples/synthetic *.json *.csv *.md
prune .audit
prune .local
prune docs
prune .docs
prune .git
prune .venv
prune dist
prune build
global-exclude __pycache__ *.py[cod] .env *.env
include configs/env.sh.example
recursive-include locks *.json *.txt *.md
